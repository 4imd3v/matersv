{
	"name": "matersv",
	"version": "0.1.1",
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"license": "MIT",
	"description": "Reusable Svelte 5 + pure CSS UI components for wide editorial website UI.",
	"keywords": [
		"svelte",
		"sveltekit",
		"svelte5",
		"ui",
		"components",
		"design-system",
		"css",
		"oklch"
	],
	"svelte": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./matersv.css": "./dist/matersv.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"package": "svelte-package -i src/lib -o dist",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"test": "vitest run",
		"publint": "publint",
		"release:patch": "pnpm version patch -m \"chore(release): %s\"",
		"release:minor": "pnpm version minor -m \"chore(release): %s\"",
		"release:major": "pnpm version major -m \"chore(release): %s\"",
		"preversion": "pnpm check && pnpm test",
		"prepublishOnly": "svelte-package -i src/lib -o dist && publint",
		"prepare": "svelte-kit sync || echo ''"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/svelte": "^5.4.2",
		"jsdom": "^30.1.3",
		"publint": "^0.3.25",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.7",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
